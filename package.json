{
  "name": "bubblecam",
  "version": "1.0.0",
  "description": "An always-on-top circular camera overlay for tutorials and screen recordings.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "io.github.mrsingh007.bubblecam",
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "Show your camera preview in a floating window."
      }
    },
    "win": {
      "target": "nsis"
    },
    "productName": "BubbleCam"
  },
  "keywords": [
    "camera app"
  ],
  "author": "GitHub",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5"
  }
}
